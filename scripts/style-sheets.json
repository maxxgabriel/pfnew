{
  "styles": {
    "pixel": {
      "ref": "ref_style_pixel.png",
      "desc": "crisp 32-bit PIXEL ART: chunky visible square pixels, a limited palette, hard pixel outlines, no anti-aliasing"
    },
    "clay": {
      "ref": "ref_style_clay.png",
      "desc": "a CLAYMATION figure: sculpted plasticine with thumbprints, soft studio lighting, slightly lumpy stop-motion shapes"
    },
    "water": {
      "ref": "ref_style_water.png",
      "desc": "a soft loose WATERCOLOUR painting: wet bleeding edges, translucent washes of indigo, black and pale blue"
    },
    "chalk": {
      "ref": "ref_style_chalk.png",
      "desc": "a WHITE CHALK LINE DRAWING: rough dusty white and pale-blue chalk outlines and scribbled hatching only, no black ink, no solid fills"
    },
    "comic": {
      "ref": "ref_style_comic.png",
      "desc": "a bold retro POP-ART COMIC: thick black outlines, flat saturated colours (deep royal-blue coat, bright yellow scarf, red boots, black hair with PALE blue highlights), Ben-Day halftone dots, hard cel shadows"
    },
    "hose": {
      "ref": "ref_rubberhose.png",
      "desc": "a 1930s RUBBER-HOSE CARTOON: black and white only, bendy noodle arms and legs, white cartoon gloves, pie-cut eyes, a bouncy round body, the same hair shape with the antenna strand and the same scarf, slightly film-grainy"
    }
  },
